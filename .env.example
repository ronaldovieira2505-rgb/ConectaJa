# Copie para .env e ajuste. Nunca coloque segredos reais neste arquivo.
# O backend lê estas variáveis do ambiente do processo (não carrega .env sozinho).
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://conectaja:conectaja@localhost:5432/conectaja

# Frontend (opcional): destino do proxy de /api no `npm run dev`
# VITE_API_PROXY_TARGET=http://localhost:8000

# ─── Produção (com DEBUG=false) ──────────────────────────────────────────────
# Origens HTTPS aceitas pelo CSRF, separadas por vírgula.
# CSRF_TRUSTED_ORIGINS=https://meuapp.azurewebsites.net
# Redireciona HTTP para HTTPS (padrão: true) e tempo do HSTS em segundos (padrão: 3600).
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600
# Limite de tentativas de login por IP (padrão: 10/min) e nível do log (padrão: WARNING).
# LOGIN_THROTTLE_RATE=10/min
# LOG_LEVEL=WARNING
# Pasta dos documentos e selfies (fora do código) e do build do frontend servido pelo Django.
# PRIVATE_MEDIA_ROOT=/home/data/private_media
# FRONTEND_DIST=/caminho/para/frontend_dist
